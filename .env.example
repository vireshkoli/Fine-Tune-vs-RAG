# Copy to .env and fill in. .env is gitignored; this file is not.
# Never put real values in this file.

# Hugging Face token. Phase 1 only needs read scope, but pushing the adapter,
# model card and Space in Phase 8 needs WRITE — generate one at
# https://huggingface.co/settings/tokens and use it from the start.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Weights & Biases, for training curves and hardware utilisation.
# https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
